<?xml version="1.0" encoding="UTF-8"?>
<!-- Reference only: `lantern daemon install` generates and loads this plist (service/launchagent.py);
     `lantern daemon install --print` shows the exact file for this machine. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lantern.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{PROJECT_DIR}}/.venv/bin/python</string>
        <string>-m</string>
        <string>lantern.cli</string>
        <string>daemon</string>
        <string>run</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HF_HUB_OFFLINE</key><string>1</string>
        <key>TRANSFORMERS_OFFLINE</key><string>1</string>
        <key>HF_HUB_DISABLE_TELEMETRY</key><string>1</string>
        <key>DO_NOT_TRACK</key><string>1</string>
        <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>{{HOME}}/Library/Application Support/Lantern/logs/daemon.log</string>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Application Support/Lantern/logs/daemon.err.log</string>
</dict>
</plist>
