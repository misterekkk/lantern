<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key><string>com.lantern.app</string>
    <key>CFBundleName</key><string>Lantern</string>
    <key>CFBundleDisplayName</key><string>Lantern</string>
    <key>CFBundleExecutable</key><string>Lantern</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>__VERSION__</string>
    <key>CFBundleVersion</key><string>__BUILD__</string>
    <key>LSMinimumSystemVersion</key><string>26.2</string>
    <key>LSUIElement</key><true/>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundleLocalizations</key><array><string>en</string><string>pl</string></array>
    <key>NSHumanReadableCopyright</key><string>Lantern — local search, no data leaves your Mac.</string>
    <key>NSDesktopFolderUsageDescription</key><string>Lantern indexes files on your Desktop locally so you can search them by meaning. Files are only read.</string>
    <key>NSDocumentsFolderUsageDescription</key><string>Lantern indexes your Documents locally so you can search them by meaning. Files are only read.</string>
    <key>NSDownloadsFolderUsageDescription</key><string>Lantern indexes your Downloads locally so you can search them by meaning. Files are only read.</string>
    <key>NSRemovableVolumesUsageDescription</key><string>Lantern can index folders on external drives that you choose.</string>
    <key>NSAppleEventsUsageDescription</key><string>Lantern opens a recording in QuickTime Player at the moment where the words you searched for are spoken, and plays the songs and playlists you choose in Music.</string>
    <key>NSAppleMusicUsageDescription</key><string>Lantern reads the names of your songs and playlists so you can find and play them from search. Nothing leaves your Mac.</string>
    <key>NSNetworkVolumesUsageDescription</key><string>Lantern can index folders on network drives that you choose.</string>
    <key>LanternPython</key><string>__PYTHON__</string>
</dict>
