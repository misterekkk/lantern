/* Welcome window (phase 17) */
"Welcome to Lantern" = "Witaj w Lanternie";
"Find anything on your Mac by what it says or shows: documents, code, PDFs, photos and recordings." = "Znajdź na Macu wszystko po tym, co zawiera lub pokazuje: dokumenty, kod, PDF-y, zdjęcia i nagrania.";
